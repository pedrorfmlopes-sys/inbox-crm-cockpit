PORT=7071
HOST=0.0.0.0

# Optional PostgreSQL persistence. DATABASE_URL is the source of truth.
# On Render/non-IPv6 runtimes, prefer the Supabase Session pooler URL instead of a direct db.<project>.supabase.* URL.
# If Postgres is repeatedly unreachable, optional stores temporarily fall back to server/data/*.json.
DATABASE_URL=
PG_FORCE_IPV4=false

# AI runtime
AI_ENABLED=0
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_QUALITY=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-1.5-flash
GEMINI_MODEL_QUALITY=gemini-1.5-pro

# Canonical Odoo credentials
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=

# Backwards-compatible aliases
ODOO_USER=
ODOO_PASS=
ODOO_PASSWORD=

# Optional
ODOO_INSECURE_TLS=false
